---
import "@fontsource-variable/onest";
import Header from "@/components/Header.astro";
import { SITE } from "@/config/site";

interface Props {
  /** Page name without the brand; the layout appends it once. */
  title?: string;
  description?: string;
  ogImage?: string;
  noindex?: boolean;
}

const DEFAULT_TITLE = "Qora — Custom Web & SaaS Development";
const DEFAULT_DESCRIPTION =
  "Web development studio. We build custom SaaS products and websites — like PrimeFit and Dask — for businesses that want to run better online.";

const {
  title,
  description = DEFAULT_DESCRIPTION,
  ogImage = SITE.ogImage ?? undefined,
  noindex = false,
} = Astro.props;

const pageTitle = title ? `${title} — ${SITE.name}` : DEFAULT_TITLE;
const canonical = new URL(Astro.url.pathname, Astro.site ?? SITE.url);
const shareImage = ogImage ? new URL(ogImage, Astro.site ?? SITE.url) : null;
---

<!doctype html>
<html lang='en'>
  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1.0' />
    <link rel='icon' type='image/svg+xml' href='/favicon.svg' />
    <meta name='generator' content={Astro.generator} />

    <title>{pageTitle}</title>
    <meta name='description' content={description} />
    <meta name='author' content={SITE.author} />
    <link rel='canonical' href={canonical} />
    <link rel='sitemap' href='/sitemap-index.xml' />
    {noindex && <meta name='robots' content='noindex, nofollow' />}

    <meta property='og:type' content='website' />
    <meta property='og:site_name' content={SITE.name} />
    <meta property='og:url' content={canonical} />
    <meta property='og:title' content={pageTitle} />
    <meta property='og:description' content={description} />
    {shareImage && <meta property='og:image' content={shareImage} />}

    <meta
      name='twitter:card'
      content={shareImage ? "summary_large_image" : "summary"}
    />
    <meta name='twitter:title' content={pageTitle} />
    <meta name='twitter:description' content={description} />
    {shareImage && <meta name='twitter:image' content={shareImage} />}

    <link
      rel='preload'
      href='https://unpkg.com/aos@next/dist/aos.css'
      as='style'
      onload="this.onload=null; this.rel='stylesheet'"
    />
  </head>
  <body>
    <Header />
    <slot />
    <script is:inline src='https://unpkg.com/aos@next/dist/aos.js'></script>
    <script is:inline>
      AOS.init({
        duration: 1000,
        once: true,
      });
    </script>
  </body>
</html>
<style is:global>
  :root {
    --max-width: 1200px;
    --padding-x: 1rem;
  }
  html {
    scroll-behavior: smooth;
    /* scroll-padding-top: 4.75rem; */
    font-family: "Onest Variable", system-ui, sans-serif;
    box-sizing: border-box;
  }
  *,
  *:before,
  *:after {
    box-sizing: inherit;
  }
  body {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    margin: 0;
    padding: 0;
    width: 100%;
  }
  @media screen and (max-width: 768px) {
    :root {
      --padding-x: 0.5rem;
    }
  }
</style>
