---
import "@fontsource-variable/onest";
import Header from "@/components/Header.astro";
import { SITE } from "@/config/site";
import type { Lang } from "@/i18n/ui";
import { alternatePath, getLang, useTranslations } from "@/i18n/utils";

interface Props {
  /** Page name without the brand; the layout appends it once. */
  title?: string;
  description?: string;
  ogImage?: string;
  noindex?: boolean;
  /** Overrides the locale for pages served outside the localized tree. */
  lang?: Lang;
  /** Set false on pages that have no counterpart in the other language. */
  alternates?: boolean;
}

const {
  title,
  description,
  ogImage = SITE.ogImage ?? undefined,
  noindex = false,
  lang = getLang(Astro.currentLocale),
  alternates = true,
} = Astro.props;

const t = useTranslations(lang);

const pageTitle = title ? `${title} — ${SITE.name}` : t.meta.defaultTitle;
const base = Astro.site ?? SITE.url;
const canonical = new URL(Astro.url.pathname, base);
const shareImage = ogImage ? new URL(ogImage, base) : null;

const alternateLinks = alternates
  ? [
      { hreflang: "es", href: new URL(alternatePath(Astro.url.pathname, "es"), base) },
      { hreflang: "en", href: new URL(alternatePath(Astro.url.pathname, "en"), base) },
      { hreflang: "x-default", href: new URL(alternatePath(Astro.url.pathname, "es"), base) },
    ]
  : [];
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1.0' />
    <link rel='icon' type='image/svg+xml' href='/favicon.svg' />
    <meta name='generator' content={Astro.generator} />

    <title>{pageTitle}</title>
    <meta name='description' content={description ?? t.meta.description} />
    <meta name='author' content={SITE.author} />
    <link rel='canonical' href={canonical} />
    <link rel='sitemap' href='/sitemap-index.xml' />
    {noindex && <meta name='robots' content='noindex, nofollow' />}
    {
      alternateLinks.map((alt) => (
        <link rel='alternate' hreflang={alt.hreflang} href={alt.href} />
      ))
    }

    <meta property='og:type' content='website' />
    <meta property='og:site_name' content={SITE.name} />
    <meta property='og:locale' content={lang === "es" ? "es_ES" : "en_US"} />
    <meta property='og:url' content={canonical} />
    <meta property='og:title' content={pageTitle} />
    <meta property='og:description' content={description ?? t.meta.description} />
    {shareImage && <meta property='og:image' content={shareImage} />}

    <meta
      name='twitter:card'
      content={shareImage ? "summary_large_image" : "summary"}
    />
    <meta name='twitter:title' content={pageTitle} />
    <meta
      name='twitter:description'
      content={description ?? t.meta.description}
    />
    {shareImage && <meta name='twitter:image' content={shareImage} />}

    <link
      rel='preload'
      href='https://unpkg.com/aos@next/dist/aos.css'
      as='style'
      onload="this.onload=null; this.rel='stylesheet'"
    />
  </head>
  <body>
    <Header lang={lang} hasAlternate={alternates} />
    <slot />
    <script is:inline src='https://unpkg.com/aos@next/dist/aos.js'></script>
    <script is:inline>
      AOS.init({
        duration: 1000,
        once: true,
      });
    </script>
  </body>
</html>
<style is:global>
  :root {
    --max-width: 1200px;
    --padding-x: 1rem;
  }
  html {
    scroll-behavior: smooth;
    /* scroll-padding-top: 4.75rem; */
    font-family: "Onest Variable", system-ui, sans-serif;
    box-sizing: border-box;
  }
  *,
  *:before,
  *:after {
    box-sizing: inherit;
  }
  body {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    margin: 0;
    padding: 0;
    width: 100%;
  }
  @media screen and (max-width: 768px) {
    :root {
      --padding-x: 0.5rem;
    }
  }
</style>
