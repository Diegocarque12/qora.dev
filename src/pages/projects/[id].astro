---
import CaseStudy from "@/components/CaseStudy/index.astro";
import Footer from "@/components/Footer.astro";
import Layout from "@/layouts/Layout.astro";
import { caseStudies, type CaseStudyId } from "@/config/caseStudies";
import { ui } from "@/i18n/ui";

export function getStaticPaths() {
  return caseStudies.map((study) => ({ params: { id: study.id } }));
}

const id = Astro.params.id as CaseStudyId;
const copy = ui.es.caseStudy.cases[id];
---

<Layout title={copy.title} description={copy.metaDescription}>
  <CaseStudy id={id} />
  <Footer />
</Layout>
