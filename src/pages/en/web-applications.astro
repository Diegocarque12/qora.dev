---
import Footer from "@/components/Footer.astro";
import ServicePage from "@/components/ServicePage/index.astro";
import Layout from "@/layouts/Layout.astro";
import { ownProducts } from "@/config/portfolio";
import { ui } from "@/i18n/ui";

const copy = ui.en.webApplications;

/** Feature images and outbound links are the same in every language. */
const featureImages = [
  "/web-development/responsive.webp",
  "/web-development/security.webp",
  "/web-development/supabase.webp",
];
---

<Layout title={copy.title} description={copy.intro}>
  <ServicePage
    copy={copy}
    featureImages={featureImages}
    projects={ownProducts(ui.en, "en")}
  />
  <Footer />
</Layout>
