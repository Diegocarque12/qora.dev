---
import Footer from "@/components/Footer.astro";
import ServicePage from "@/components/ServicePage/index.astro";
import Layout from "@/layouts/Layout.astro";
import { clientSites } from "@/config/portfolio";
import { ui } from "@/i18n/ui";

const copy = ui.en.marketingWebsites;

/** Feature images and outbound links are the same in every language. */
const featureImages = [
  "/marketing-webs/figma-design.webp",
  "/marketing-webs/performance.webp",
  "/marketing-webs/copywriting.webp",
];
---

<Layout title={copy.title} description={copy.intro}>
  <ServicePage
    copy={copy}
    featureImages={featureImages}
    projects={clientSites(ui.en)}
  />
  <Footer />
</Layout>
