---
import type { Lang } from "@/i18n/ui";
import {
  alternatePath,
  getLang,
  localizePath,
  useTranslations,
} from "@/i18n/utils";

interface Props {
  lang?: Lang;
  /** False when this page has no counterpart in the other language. */
  hasAlternate?: boolean;
}

const { lang = getLang(Astro.currentLocale), hasAlternate = true } = Astro.props;
const t = useTranslations(lang);

const otherLang: Lang = lang === "es" ? "en" : "es";
const homePath = localizePath("/", lang);
const onHome = Astro.url.pathname === homePath;

/** Hash links stay in-page on the home page and jump back to it elsewhere. */
const section = (id: string) => (onHome ? `#${id}` : `${homePath}#${id}`);

const navItems = [
  { href: onHome ? "#hero" : homePath, label: t.nav.home },
  { href: section("services"), label: t.nav.services },
  { href: section("projects"), label: t.nav.projects },
  { href: section("about"), label: t.nav.about },
  { href: section("contact"), label: t.nav.contact },
];

const switcherHref = hasAlternate
  ? alternatePath(Astro.url.pathname, otherLang)
  : localizePath("/", otherLang);

const navLinkClass =
  "text-2xl font-medium hover:text-gray-600 transition-colors lg:text-base lg:mx-4";
---

<header
  class='fixed top-0 left-0 right-0 bg-white z-40 flex justify-between items-center py-4 px-6 md:px-8 shadow-sm'
>
  <span class='font-semibold text-2xl sm:text-3xl'
    ><a href={homePath}>Qora.dev</a></span
  >

  <button
    id='menu-toggle'
    class='lg:hidden focus:outline-none hover:opacity-75 transition-opacity'
    aria-label={t.nav.openMenu}
    aria-controls='mobile-menu'
    aria-expanded='false'
  >
    <svg
      class='w-7 h-7'
      fill='none'
      stroke='currentColor'
      viewBox='0 0 24 24'
      xmlns='http://www.w3.org/2000/svg'
      aria-hidden='true'
    >
      <path
        stroke-linecap='round'
        stroke-linejoin='round'
        stroke-width='2'
        d='M4 6h16M4 12h16m-7 6h7'></path>
    </svg>
  </button>
  <nav
    id='mobile-menu'
    class='hidden lg:flex lg:relative lg:flex-row lg:bg-transparent lg:inset-auto lg:space-y-0 fixed inset-0 bg-white/95 backdrop-blur-sm z-50 items-center justify-center transition-all duration-300 ease-in-out'
  >
    <button
      id='close-menu'
      class='absolute top-6 right-6 lg:hidden focus:outline-none hover:opacity-75 transition-opacity'
      aria-label={t.nav.closeMenu}
    >
      <svg
        class='w-7 h-7'
        fill='none'
        stroke='currentColor'
        viewBox='0 0 24 24'
        xmlns='http://www.w3.org/2000/svg'
        aria-hidden='true'
      >
        <path
          stroke-linecap='round'
          stroke-linejoin='round'
          stroke-width='2'
          d='M6 18L18 6M6 6l12 12'></path>
      </svg>
    </button>

    {navItems.map((item) => <a href={item.href} class={navLinkClass}>{item.label}</a>)}

    <a
      href={switcherHref}
      hreflang={otherLang}
      aria-label={t.nav.switchLanguage}
      class='text-2xl font-medium hover:text-gray-600 transition-colors lg:text-base lg:mx-4 lg:hidden uppercase'
      >{otherLang}</a
    >
  </nav>

  <div class='flex items-center gap-1'>
    <a
      href={switcherHref}
      hreflang={otherLang}
      aria-label={t.nav.switchLanguage}
      class='hidden lg:inline-block text-black px-3 py-2.5 hover:bg-gray-800 hover:text-white transition-colors rounded-md font-medium uppercase'
      >{otherLang}</a
    >
    <a
      href={section("contact")}
      class='hidden lg:inline-block bg-black text-white px-5 py-2.5 hover:bg-gray-800 transition-colors rounded-md font-medium'
      >{t.nav.cta}</a
    >
  </div>
</header>
<div class='h-20'></div>

<script>
  import { initMenu } from "@/scripts/menu.js";
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initMenu);
  } else {
    initMenu();
  }
</script>
