---
import Button from "@/composables/buttons/Button.astro";
import { getLang, useTranslations } from "@/i18n/utils";

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
---

<section
  class="hero bg-white h-full min-h-[45rem] py-8 px-4 sm:py-12 md:py-16 lg:py-24 relative"
  id="hero"
>
  <div class="container mx-auto flex flex-col items-center">
    <h1 class="relative text-center mt-16 sm:mt-0">
      <span
        class="block text-lg sm:text-xl"
        data-aos="fade-down"
        data-aos-duration="800"
        >{t.hero.lead} <span
          class="text-5xl sm:text-6xl md:text-7xl lg:text-8xl xl:text-9xl font-extrabold"
          data-aos="zoom-in"
          data-aos-duration="1200"
          data-aos-delay="400">{t.hero.display}</span
        ></span
      >
      <span
        class="agency-text text-5xl sm:text-6xl md:text-7xl lg:text-8xl xl:text-9xl font-extrabold ml-8 sm:ml-16 md:ml-24 lg:ml-44"
        data-aos="fade-left"
        data-aos-duration="1000"
        data-aos-delay="800">{t.hero.accent}</span
      >
    </h1>
    <p
      class="text-base sm:text-lg lg:text-xl text-pretty text-center max-w-3xl my-6 sm:my-8 lg:my-10 px-4"
      data-aos="flip-up"
      data-aos-delay="1200"
      data-aos-duration="1000"
    >
      {t.hero.paragraph}
    </p>

    <div data-aos="zoom-in" data-aos-delay="1400" data-aos-duration="800">
      <Button label={t.hero.button} />
    </div>
    <div
      class="services flex flex-wrap justify-center gap-3 sm:gap-4 mt-16 sm:mt-12 lg:mt-28 lg:mb-16"
    >
      {
        t.hero.pills.map((pill) => (
          <div
            class="flex items-center lg:text-black px-4 sm:px-6 py-2 sm:py-3 rounded-full border-gray-200 border-2 hover:bg-gray-100 transition-colors duration-300 text-sm sm:text-base"
            data-aos="fade-up"
            data-aos-delay="600"
            data-aos-duration="600"
          >
            {pill}
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .hero {
    background-image: url("/hero/bg-hero.svg");
    background-position: center 12%;
    background-repeat: no-repeat;
    background-size: contain;
  }
  .agency-text::before {
    content: "";
    background-image: url("/hero/arrow-hero.svg");
    background-size: 10rem;
    background-repeat: no-repeat;
    background-position: bottom;
    height: 4rem;
    width: 6rem;
    position: absolute;
    left: 0;
  }

  @media (min-width: 640px) {
    .agency-text::before {
      height: 5rem;
      width: 8rem;
    }
  }

  @media (min-width: 1024px) {
    .agency-text::before {
      height: 6.5rem;
      width: 10rem;
    }
  }
</style>
