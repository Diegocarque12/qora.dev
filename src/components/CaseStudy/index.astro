---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import ExternalLink from "@/assets/icons/ExternalLink.astro";
import { caseStudies, type CaseStudyId } from "@/config/caseStudies";
import { getLang, localizePath, useTranslations } from "@/i18n/utils";

interface Props {
  id: CaseStudyId;
}

const { id } = Astro.props;
const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);

const index = caseStudies.findIndex((entry) => entry.id === id);
const study = caseStudies[index];
const nextStudy = caseStudies[(index + 1) % caseStudies.length];
const copy = t.caseStudy.cases[id];
const card = t.projects.cases[id];

const projectsPath = `${localizePath("/", lang)}#projects`;
const contactPath = `${localizePath("/", lang)}#contact`;

/**
 * Every image dropped into src/assets/projects/<id>/ shows up in the process
 * gallery, ordered by file name; the grid disappears when there are none.
 */
const galleryModules = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/projects/*/*.{avif,jpg,jpeg,png,webp}",
  { eager: true }
);
const gallery = Object.entries(galleryModules)
  .filter(([path]) => path.includes(`/projects/${id}/`))
  .sort(([a], [b]) => a.localeCompare(b))
  .map(([, module]) => module.default);
---

<main>
  <section class='bg-[#111111] text-white'>
    <div class='container mx-auto max-w-5xl px-8 py-16 md:py-24'>
      <a
        href={projectsPath}
        class='inline-flex items-center gap-2 text-sm text-gray-400 hover:text-white transition-colors'
      >
        <svg
          width='16'
          height='16'
          viewBox='0 0 24 24'
          fill='none'
          stroke='currentColor'
          stroke-width='2'
          xmlns='http://www.w3.org/2000/svg'
          aria-hidden='true'
        >
          <path
            stroke-linecap='round'
            stroke-linejoin='round'
            d='M19 12H5m0 0l6 6m-6-6l6-6'></path>
        </svg>
        {t.caseStudy.backLabel}
      </a>

      <p class='mt-10 text-xs uppercase tracking-wide text-gray-400'>
        {t.caseStudy.eyebrow} · {card.tag}
      </p>
      <h1 class='mt-3 text-4xl sm:text-5xl md:text-6xl font-bold' data-aos='fade-up'>
        {study.name}
      </h1>
      <p
        class='mt-3 text-xl text-gray-300'
        data-aos='fade-up'
        data-aos-delay='100'
      >
        {copy.tagline}
      </p>
      <p
        class='mt-6 max-w-3xl text-gray-300 leading-relaxed'
        data-aos='fade-up'
        data-aos-delay='200'
      >
        {copy.intro}
      </p>
      <a
        href={study.url}
        target='_blank'
        rel='noopener noreferrer'
        class='mt-8 inline-flex items-center gap-2 border border-white/40 rounded-full px-6 py-3 text-sm transition-colors duration-300 hover:bg-white hover:text-black'
      >
        {card.cta}
        <ExternalLink />
      </a>
    </div>
  </section>

  <section class='container mx-auto max-w-5xl px-8 py-16 md:py-20'>
    <h2 class='text-3xl md:text-4xl font-bold mb-8' data-aos='fade-up'>
      {t.caseStudy.storyHeading}
    </h2>
    <div class='max-w-3xl space-y-6'>
      {
        copy.story.map((paragraph) => (
          <p class='text-lg text-gray-600 leading-relaxed'>{paragraph}</p>
        ))
      }
    </div>
    {
      card.outcome && (
        <p
          class='mt-10 max-w-3xl border-l-2 border-black pl-6 text-xl font-medium'
          data-aos='fade-up'
        >
          <span class='block text-xs uppercase tracking-wide text-gray-500 mb-1'>
            {t.projects.outcomeLabel}
          </span>
          {card.outcome}
        </p>
      )
    }
  </section>

  <section class='container mx-auto max-w-5xl px-8 pb-16 md:pb-20'>
    <div class='bg-gray-50 rounded-3xl p-8 md:p-12' data-aos='fade-up'>
      <h2 class='text-3xl md:text-4xl font-bold mb-8'>
        {t.caseStudy.processHeading}
      </h2>
      <div class='max-w-3xl space-y-6'>
        {
          copy.process.map((paragraph) => (
            <p class='text-gray-600 leading-relaxed'>{paragraph}</p>
          ))
        }
      </div>
      {
        gallery.length > 0 && (
          <div class='grid grid-cols-1 sm:grid-cols-2 gap-6 mt-10'>
            {gallery.map((image, imageIndex) => (
              <Image
                src={image}
                alt={`${t.caseStudy.galleryAlt} ${study.name} (${imageIndex + 1})`}
                class={`w-full h-auto rounded-xl border border-gray-200 bg-white ${imageIndex === 0 ? "sm:col-span-2" : ""}`}
                loading='lazy'
              />
            ))}
          </div>
        )
      }
    </div>
  </section>

  <section class='container mx-auto max-w-5xl px-8 pb-16 md:pb-20'>
    <h2 class='text-3xl md:text-4xl font-bold mb-8' data-aos='fade-up'>
      {t.caseStudy.visionHeading}
    </h2>
    <div class='max-w-3xl space-y-6'>
      {
        copy.vision.map((paragraph) => (
          <p class='text-lg text-gray-600 leading-relaxed'>{paragraph}</p>
        ))
      }
    </div>
  </section>

  <section class='container mx-auto max-w-5xl px-8 pb-16 md:pb-24'>
    <h2 class='text-3xl md:text-4xl font-bold mb-10' data-aos='fade-up'>
      {t.caseStudy.differenceHeading}
    </h2>
    <div class='grid grid-cols-1 md:grid-cols-3 gap-6'>
      {
        copy.difference.map((item, itemIndex) => (
          <article
            class='bg-gray-50 rounded-2xl p-8'
            data-aos='fade-up'
            data-aos-delay={String(itemIndex * 150)}
          >
            <span class='block text-sm font-semibold text-gray-400 mb-3'>
              {String(itemIndex + 1).padStart(2, "0")}
            </span>
            <h3 class='text-xl font-bold mb-3'>{item.title}</h3>
            <p class='text-gray-600'>{item.body}</p>
          </article>
        ))
      }
    </div>
  </section>

  <section class='bg-[#111111] text-white'>
    <div class='container mx-auto max-w-5xl px-8 py-16 md:py-20 text-center'>
      <h2 class='text-3xl md:text-4xl font-bold mb-4' data-aos='fade-up'>
        {t.caseStudy.ctaHeading}
      </h2>
      <p class='max-w-2xl mx-auto mb-8 text-gray-300'>{t.caseStudy.ctaBody}</p>
      <div class='flex flex-wrap items-center justify-center gap-4'>
        <a
          href={contactPath}
          class='bg-white text-black px-8 py-3 rounded-md font-medium hover:bg-gray-200 transition-colors'
        >
          {t.caseStudy.ctaButton}
        </a>
        <a
          href={localizePath(`/projects/${nextStudy.id}`, lang)}
          class='border border-white/40 rounded-md px-8 py-3 text-sm transition-colors duration-300 hover:bg-white hover:text-black'
        >
          {t.caseStudy.nextCaseLabel}: {nextStudy.name}
        </a>
      </div>
    </div>
  </section>
</main>
