---
import FooterBar from "@/components/FooterBar.astro";
import { getLang, localizePath, useTranslations } from "@/i18n/utils";

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
---

<FooterBar>
  <div class='min-h-[30rem] flex flex-col'>
    <div
      class='flex flex-col items-center justify-center mt-18 px-4 text-center'
    >
      <p class='mb-8 text-gray-400 text-base sm:text-lg md:text-xl'>
        {t.footer.tagline}
      </p>
      <h2 class='text-4xl sm:text-5xl md:text-7xl font-bold'>
        <a
          href={`${localizePath("/", lang)}#contact`}
          class='hover:text-gray-300 transition-colors duration-300'
        >
          {t.footer.cta}
        </a>
      </h2>
    </div>
    <span class='labsLetters'>Qora</span>
  </div>
</FooterBar>

<style>
  .labsLetters {
    text-align: center;
    -webkit-text-stroke-width: 2px;
    -webkit-text-stroke-color: rgba(255, 255, 255, 0.1);
    color: transparent;
    font-size: clamp(100px, 15vw, 200px);
    font-style: normal;
    font-weight: 800;
  }
</style>
