---
import { SITE } from "@/config/site";
import { getLang, useTranslations } from "@/i18n/utils";

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);

const body = t.about.body.replace("{year}", String(SITE.foundingYear));
---

<section
  class="py-12 px-6 bg-background text-foreground"
  data-aos="fade-up"
  id="about"
>
  <div class="max-w-5xl mx-auto flex flex-col gap-4">
    <span class="text-muted text-sm font-medium flex gap-2 items-center">
      <svg
        width="40"
        height="20"
        xmlns="http://www.w3.org/2000/svg"
        aria-hidden="true"
      >
        <line x1="0" y1="10" x2="30" y2="10" stroke="black" stroke-width="1"
        ></line>
        <circle cx="35" cy="10" r="4" fill="white" stroke="black"></circle>
      </svg>

      {t.about.eyebrow}</span
    >
    <h2 class="text-4xl font-extrabold md:w-[35rem] w-full">
      {t.about.heading}
    </h2>
    <p class="text-sm text-muted-foreground mb-4 text-gray-600 md:max-w-3xl">
      {body}
    </p>
    <a
      href={SITE.social.linkedin}
      target="_blank"
      rel="noopener noreferrer"
      class="text-sm font-medium text-black underline underline-offset-4 hover:no-underline mb-8 w-fit"
    >
      {t.about.linkedin}
    </a>
    <div class="flex flex-col md:flex-row relative">
      <img
        src="/about/main.webp"
        alt={t.about.imageAlt}
        width="400"
        height="500"
        loading="lazy"
        decoding="async"
        class="h-auto w-full md:h-[31.25rem] md:w-[25rem] object-cover"
      />

      <div
        class="flex flex-col w-full p-4 md:p-8 border-t border-l md:ml-8 mt-4 md:mt-0"
      >
        {
          t.about.cards.map((card, index) => (
            <div class="bg-card p-4 md:p-6 md:pr-0">
              <span class="text-gray-400">
                {String(index + 1).padStart(2, "0")}.
              </span>
              <h3 class="text-xl md:text-2xl font-semibold mb-2">
                {card.title}
              </h3>
              <p class="text-muted-foreground text-sm text-gray-600">
                {card.body}
              </p>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
