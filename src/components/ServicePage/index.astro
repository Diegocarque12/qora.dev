---
import { Image } from "astro:assets";
import ExternalLink from "@/assets/icons/ExternalLink.astro";
import type { PortfolioEntry } from "@/config/portfolio";
import type { ServicePageCopy } from "@/i18n/ui";
import { getLang, localizePath, useTranslations } from "@/i18n/utils";

interface Props {
  copy: ServicePageCopy;
  featureImages: readonly string[];
  projects: readonly PortfolioEntry[];
}

const { copy, featureImages, projects } = Astro.props;
const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);

const contactHref = `${localizePath("/", lang)}#contact`;
const allServicesHref = localizePath("/all-services", lang);
const delays = ["0", "150", "300", "450"];
---

<main class='bg-white'>
  <section class='container mx-auto px-8 pt-16 pb-12 md:pt-24 md:pb-16'>
    <div class='max-w-4xl mx-auto text-center flex flex-col items-center gap-6'>
      <h1
        class='text-4xl md:text-6xl font-extrabold text-balance'
        data-aos='fade-up'
        data-aos-duration='800'
      >
        {copy.heading}
      </h1>
      <p
        class='text-lg md:text-xl text-gray-600 text-pretty'
        data-aos='fade-up'
        data-aos-delay='150'
      >
        {copy.intro}
      </p>
      <a
        href={contactHref}
        class='inline-flex items-center gap-2 bg-black text-white px-8 py-3 text-lg font-semibold transition-transform duration-300 ease-in-out hover:-translate-y-1 hover:shadow-lg mt-2'
        data-aos='fade-up'
        data-aos-delay='300'
      >
        {copy.ctaButton}
        <svg
          xmlns='http://www.w3.org/2000/svg'
          class='h-5 w-5'
          viewBox='0 0 20 20'
          fill='currentColor'
          aria-hidden='true'
        >
          <path
            fill-rule='evenodd'
            d='M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z'
            clip-rule='evenodd'></path>
        </svg>
      </a>
    </div>
  </section>

  <section class='container mx-auto px-8 pb-16 md:pb-24'>
    <h2 class='sr-only'>{copy.title}</h2>
    <div class='grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8'>
      {
        copy.features.map((feature, index) => (
          <article
            class='bg-gray-50 rounded-2xl p-8'
            data-aos='fade-up'
            data-aos-delay={delays[index]}
          >
            <img
              src={featureImages[index]}
              alt={feature.imageAlt}
              width="400"
              height="192"
              loading="lazy"
              decoding="async"
              class='w-full h-48 object-cover rounded-lg mb-6'
            />
            <h3 class='text-2xl font-bold mb-4'>{feature.title}</h3>
            <p class='text-gray-600'>{feature.description}</p>
          </article>
        ))
      }
    </div>
  </section>

  <section class='bg-[#111111] text-white'>
    <div class='container mx-auto px-8 py-16 md:py-24'>
      <div class='max-w-3xl flex flex-col gap-4 mb-12'>
        <h2 class='text-3xl md:text-5xl font-bold' data-aos='fade-up'>
          {copy.projectsHeading}
        </h2>
        <p class='text-gray-300'>{copy.projectsIntro}</p>
      </div>

      <div class='grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8'>
        {
          projects.map((project, index) => (
            <article
              class='border border-white/15 flex flex-col transition-colors duration-300 hover:border-white/40'
              data-aos='fade-up'
              data-aos-delay={delays[index % delays.length]}
            >
              {project.image && (
                <Image
                  src={project.image}
                  alt={project.imageAlt}
                  widths={[400, 640]}
                  sizes='(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw'
                  class='w-full h-48 object-cover object-top border-b border-white/15'
                  loading='lazy'
                />
              )}
              <div class='flex flex-col gap-2 p-6 flex-grow'>
                <h3 class='text-lg font-semibold'>{project.name}</h3>
                <p class='text-sm text-gray-400 flex-grow'>
                  {project.description}
                </p>
                <div class='flex flex-wrap items-center gap-x-5 gap-y-2 mt-2'>
                  {project.caseHref && (
                    <a
                      href={project.caseHref}
                      class='inline-flex items-center gap-2 text-sm font-medium underline-offset-4 hover:underline'
                    >
                      {t.projects.readCase}
                    </a>
                  )}
                  <a
                    href={project.url}
                    target='_blank'
                    rel='noopener noreferrer'
                    class='inline-flex items-center gap-2 text-sm text-gray-400 hover:text-white transition-colors underline-offset-4 hover:underline'
                  >
                    {project.domain}
                    <ExternalLink />
                  </a>
                </div>
              </div>
            </article>
          ))
        }
      </div>

      <a
        href={allServicesHref}
        class='inline-flex items-center gap-2 border border-white/40 rounded-full px-6 py-3 text-sm transition-colors duration-300 hover:bg-white hover:text-black mt-12'
      >
        {t.projects.viewAll}
        <svg
          width='40'
          height='8'
          viewBox='0 0 50 10'
          fill='none'
          xmlns='http://www.w3.org/2000/svg'
          aria-hidden='true'
        >
          <path d='M0.231934 1L48.0951 1L36.0525 9' stroke='currentColor'></path>
        </svg>
      </a>
    </div>
  </section>

  <section class='container mx-auto px-8 py-16 md:py-24'>
    <div class='bg-gray-50 rounded-3xl p-8 md:p-12' data-aos='fade-up'>
      <h2 class='text-3xl md:text-5xl font-bold text-center mb-12'>
        {copy.processHeading}
      </h2>
      <ol class='grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8'>
        {
          copy.process.map((step, index) => (
            <li data-aos='fade-up' data-aos-delay={delays[index]}>
              <span class='block text-sm font-semibold text-gray-400 mb-2'>
                {String(index + 1).padStart(2, "0")}
              </span>
              <h3 class='text-xl font-bold mb-3'>{step.title}</h3>
              <p class='text-gray-600'>{step.body}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class='container mx-auto px-8 pb-16 md:pb-24'>
    <div class='max-w-3xl mx-auto text-center flex flex-col items-center gap-6'>
      <h2 class='text-3xl md:text-4xl font-bold text-balance' data-aos='fade-up'>
        {copy.ctaHeading}
      </h2>
      <p class='text-gray-600 text-pretty'>{copy.ctaBody}</p>
      <a
        href={contactHref}
        class='inline-flex items-center gap-2 bg-black text-white px-8 py-3 text-lg font-semibold transition-transform duration-300 ease-in-out hover:-translate-y-1 hover:shadow-lg'
      >
        {copy.ctaButton}
        <svg
          xmlns='http://www.w3.org/2000/svg'
          class='h-5 w-5'
          viewBox='0 0 20 20'
          fill='currentColor'
          aria-hidden='true'
        >
          <path
            fill-rule='evenodd'
            d='M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z'
            clip-rule='evenodd'></path>
        </svg>
      </a>
    </div>
  </section>
</main>
