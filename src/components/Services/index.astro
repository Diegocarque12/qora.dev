---
import Card from "@/composables/Card.astro";
import { getLang, localizePath, useTranslations } from "@/i18n/utils";

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);

/** Copy comes from the dictionary; assets and targets stay language-neutral. */
const serviceAssets = [
  { img: "/web-solutions.svg", link: localizePath("/marketing-websites", lang) },
  { img: "/digital-marketing.svg", link: localizePath("/web-applications", lang) },
];

const services = t.services.items.map((item, index) => ({
  ...item,
  ...serviceAssets[index],
}));
---

<section
  class="bg-background text-foreground py-4 sm:py-8 md:py-16 lg:py-24 scroll-mt-20"
  data-aos="fade-up"
  id="services"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    <h2
      class="text-xl sm:text-2xl md:text-3xl font-extrabold mb-4 sm:mb-8 md:mb-16"
    >
      {t.services.heading}
    </h2>
    <div
      class="grid grid-cols-1 sm:grid-cols-2 gap-4 sm:gap-6 md:gap-8 justify-items-center"
    >
      {
        services.map((service) => (
          <Card
            category={service.category}
            title={service.title}
            description={service.description}
            img={service.img}
            link={service.link}
            linkLabel={t.services.cardLink}
          />
        ))
      }
    </div>
    <a
      href={localizePath("/all-services", lang)}
      class="inline-flex items-center bg-black hover:bg-white hover:text-black text-white px-3 sm:px-4 md:px-6 py-2 mt-4 mb-8 sm:mb-0 sm:mt-12 md:mt-16 lg:mt-24 mx-auto transition-colors duration-300 ease-in-out hover:shadow-lg text-xs sm:text-sm md:text-base"
    >
      {t.services.cta}
      <svg
        xmlns="http://www.w3.org/2000/svg"
        class="h-3 w-3 sm:h-4 sm:w-4 md:h-5 md:w-5 ml-2"
        viewBox="0 0 20 20"
        fill="none"
        stroke="currentColor"
        stroke-width="1"
      >
        <path d="M5 10h10" stroke-linecap="round" stroke-linejoin="round"
        ></path>
      </svg>
    </a>
  </div>
</section>
