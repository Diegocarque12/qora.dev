---
import ExternalLink from "@/assets/icons/ExternalLink.astro";
import { caseStudies } from "@/config/caseStudies";
import { getLang, localizePath, useTranslations } from "@/i18n/utils";

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
---

<div
  class="bg-[#111111] text-foreground p-4 sm:p-6 lg:p-8 lg:pl-48 min-h-screen flex flex-col lg:flex-row relative scroll-mt-[4.75rem]"
  data-aos="fade-up"
  id="projects"
>
  <div class="absolute bottom-0 left-0 hidden sm:block">
    <svg
      width="100%"
      height="250"
      viewBox="0 0 287 83"
      fill="none"
      xmlns="http://www.w3.org/2000/svg"
      class="max-w-[500px]"
      aria-hidden="true"
    >
      <path
        opacity="0.1"
        d="M38.5641 1L2 29.2919H75.6292L34.0562 61.4593H106.183V82H287"
        stroke="#E4E4E4"></path>
    </svg>
  </div>
  <div class="absolute hidden sm:block">
    <svg
      width="100%"
      height="74"
      viewBox="0 0 266 74"
      fill="none"
      xmlns="http://www.w3.org/2000/svg"
      class="max-w-[266px]"
      aria-hidden="true"
    >
      <path
        opacity="0.1"
        d="M30.0098 1L1 45.5L18.9274 73H168.866L147.027 39.5H266"
        stroke="white"></path>
    </svg>
  </div>

  <div
    class="flex flex-col items-start justify-center mb-4 gap-4 px-4 sm:px-6 lg:px-32 w-full lg:w-1/2"
  >
    <span
      class="hidden text-muted text-sm font-medium text-white lg:flex gap-2 items-center"
    >
      <svg width="40" height="20" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <line x1="0" y1="10" x2="30" y2="10" stroke="white" stroke-width="1"
        ></line>
        <circle cx="35" cy="10" r="4" fill="" stroke="white"></circle>
      </svg>
      {t.projects.eyebrow}</span
    >
    <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold mb-4 text-white">
      {t.projects.heading}
    </h2>
    <p class="text-muted-foreground mb-8 text-gray-300 text-sm lg:mr-28">
      {t.projects.intro}
    </p>

    <a
      href={localizePath("/all-services", lang)}
      class="inline-flex items-center gap-2 text-white border border-white/40 rounded-full px-6 py-3 text-sm transition-colors duration-300 hover:bg-white hover:text-black"
    >
      {t.projects.viewAll}
      <svg
        width="40"
        height="8"
        viewBox="0 0 50 10"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
        aria-hidden="true"
      >
        <path d="M0.231934 1L48.0951 1L36.0525 9" stroke="currentColor"></path>
      </svg>
    </a>
  </div>

  <div
    class="mt-8 w-full lg:w-1/2 flex flex-col gap-6 px-4 sm:px-6 lg:px-0 lg:pr-16"
  >
    {
      caseStudies.map((project) => {
        const copy = t.projects.cases[project.id];
        return (
          <article class="border border-white/15 p-6 sm:p-8 flex flex-col gap-4 transition-colors duration-300 hover:border-white/40">
            <div class="flex flex-col gap-1">
              <span class="text-xs uppercase tracking-wide text-gray-400">
                {copy.tag}
              </span>
              <h3 class="text-2xl sm:text-3xl font-bold text-white">
                {project.name}
              </h3>
            </div>

            <p class="text-sm text-gray-300">{copy.whatItIs}</p>
            <p class="text-sm text-gray-400">{copy.forWhom}</p>

            {copy.outcome && (
              <p class="text-sm text-white border-l-2 border-white/40 pl-4">
                <span class="block text-xs uppercase tracking-wide text-gray-400">
                  {t.projects.outcomeLabel}
                </span>
                {copy.outcome}
              </p>
            )}

            <a
              href={project.url}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 text-white text-sm font-medium underline-offset-4 hover:underline mt-2"
            >
              {copy.cta}
              <ExternalLink />
            </a>
          </article>
        );
      })
    }
  </div>
</div>
